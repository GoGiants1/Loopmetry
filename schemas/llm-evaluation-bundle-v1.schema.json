{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/GoGiants1/Loopmetry/schemas/llm-evaluation-bundle-v1.schema.json",
  "title": "Loopmetry LLM Evaluation Bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bundle_id",
    "schema_version",
    "scope",
    "project_id",
    "producer",
    "source_coverage",
    "policy",
    "project_facts",
    "events",
    "outbound_manifest"
  ],
  "properties": {
    "bundle_id": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "schema_version": {
      "const": "0.1"
    },
    "scope": {
      "const": "project"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "event_schema_version"],
      "properties": {
        "name": {"const": "loopmetry"},
        "version": {"type": "string", "minLength": 1},
        "event_schema_version": {"type": "string", "minLength": 1}
      }
    },
    "source_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources",
        "event_count",
        "session_count",
        "started_at",
        "ended_at"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "event_count": {"type": "integer", "minimum": 1},
        "session_count": {"type": "integer", "minimum": 1},
        "started_at": {"type": "string", "format": "date-time"},
        "ended_at": {"type": "string", "format": "date-time"}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "raw_prompts_included",
        "raw_agent_messages_included",
        "source_code_included",
        "raw_command_text_included",
        "absolute_paths_redacted",
        "deterministic_scores_included",
        "untrusted_content_notice"
      ],
      "properties": {
        "mode": {"const": "normalized-evidence-only"},
        "raw_prompts_included": {"const": false},
        "raw_agent_messages_included": {"const": false},
        "source_code_included": {"const": false},
        "raw_command_text_included": {"const": false},
        "absolute_paths_redacted": {"const": true},
        "deterministic_scores_included": {"const": false},
        "untrusted_content_notice": {"type": "string", "minLength": 1}
      }
    },
    "project_facts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot", "measurement_gaps"],
      "properties": {
        "snapshot": {"type": "object"},
        "measurement_gaps": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "session_id",
          "timestamp",
          "type",
          "actor",
          "source",
          "summary",
          "requirement_ids",
          "paths"
        ],
        "properties": {
          "event_id": {"type": "string", "minLength": 1},
          "session_id": {"type": "string", "minLength": 1},
          "timestamp": {"type": "string", "format": "date-time"},
          "type": {"type": "string", "minLength": 1},
          "actor": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "summary": {"type": "string", "minLength": 1, "maxLength": 500},
          "requirement_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string"}
          },
          "paths": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string"}
          },
          "details": {"type": "object"}
        }
      }
    },
    "outbound_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["included", "excluded"],
      "properties": {
        "included": {
          "type": "array",
          "items": {"type": "string"}
        },
        "excluded": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    }
  }
}
